APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Telegram Native SDK (iOS/Android) uchun faqat client_id kerak.
# ID tokenni native SDK qaytaradi, backend JWKS orqali signature verify qiladi.
# Client secret va redirect URI'lar BotFatherda va native app konfiguratsiyasida saqlanadi.
TELEGRAM_LOGIN_CLIENT_ID=

# SEO: ijtimoiy preview rasmi (to‘liq HTTPS URL). Bo‘sh qoldiring — sayt logosi ishlatiladi.
# SEO_OG_IMAGE=https://kitobchi.com/images/og-default.jpg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Paylov va OFD fiskalizatsiya
PAYLOV_BASE_URL=https://gw.paylov.uz
PAYLOV_ACCESS_TOKEN=
PAYLOV_CONSUMER_KEY=
PAYLOV_CONSUMER_SECRET=
PAYLOV_USERNAME=
PAYLOV_PASSWORD=
PAYLOV_MERCHANT_ID=
PAYLOV_OFD_ENABLED=false
PAYLOV_OFD_SPLIT_CREDIT_RECEIPT_TYPE=2
PAYLOV_OFD_SPLIT_ADVANCE_CONTRACT_ID=
PAYLOV_OFD_AMOUNT_MULTIPLIER=100
PAYLOV_OFD_VAT_PERCENT=0
PAYLOV_OFD_TIN=
PAYLOV_OFD_BOOK_IKPU=
PAYLOV_OFD_BOOK_PACKAGE_CODE=
PAYLOV_OFD_STATIONERY_IKPU=
PAYLOV_OFD_STATIONERY_PACKAGE_CODE=
PAYLOV_OFD_SERVICE_IKPU=
PAYLOV_OFD_SERVICE_PACKAGE_CODE=

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Qidiruv (Laravel Scout + Meilisearch) — self-hosted, bepul, xato-toleranti
# to'liq matnli qidiruv motori. HOST/KEY bo'sh yoki server ishlamayotgan
# bo'lsa, SearchController avtomatik ravishda eski MySQL yo'liga qaytadi.
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Karyera javoblari uchun Reply-To (nomzod “Javob” tugmasini bossa shu manzilga boradi)
MAIL_REPLY_TO_ADDRESS=null
MAIL_REPLY_TO_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=

# OpenAI va mahsulot AI moderatsiyasi
OPENAI_API_KEY=
PRODUCT_AI_MODERATION_ENABLED=true
PRODUCT_AI_MODERATION_MODEL=gpt-4o-mini
PRODUCT_AI_MODERATION_BATCH_SIZE=4
PRODUCT_AI_MODERATION_RUN_LIMIT=80
PRODUCT_AI_MODERATION_MAX_IMAGES=3
PRODUCT_AI_MODERATION_IMAGE_DETAIL=high
PRODUCT_AI_MODERATION_APPROVAL_CONFIDENCE=0.78
PRODUCT_AI_MODERATION_PROCESSING_TIMEOUT=45
PRODUCT_AI_MODERATION_MAX_RETRY_MINUTES=1440

# UzPost jo'natmalarini kuzatish
UZPOST_TRACKING_URL=https://tracking.pochta.uz/api/v1/public/test
UZPOST_CONNECT_TIMEOUT=3
UZPOST_TIMEOUT=7
UZPOST_SYNC_INTERVAL_MINUTES=10

# Yandex Maps JS API 2.1 kaliti (boshqaruv > logistika zonalar xaritasi)
# https://developer.tech.yandex.ru/services -> "JavaScript API va HTTP Geocoder"
YANDEX_MAPS_API_KEY=
YANDEX_MAPS_LANG=ru_RU

# Meta Instagram Webhook & Graph API Credentials
# Bot "Instagram API with Instagram Login" oqimi orqali ishlaydi (Facebook
# Page kerak emas) — Meta App Dashboard > Instagram > API setup with
# Instagram Login bo'limida sozlanadi.
INSTAGRAM_VERIFY_TOKEN=kitobchi_sec_token_2026
# Instagram User Access Token — Dashboard'dagi "Generate token" (Сгенерировать
# маркер) tugmasi orqali olinadi. Standart (qisqa/uzun muddatli) token 60
# kunda tugaydi, shu sabab uni /access_token endpointi orqali muntazam
# yangilab turish kerak (Meta docs: "Access Token" reference).
INSTAGRAM_ACCESS_TOKEN=
# ESKI (endi ishlatilmaydi) — Facebook Login/Page-based oqim uchun Page
# Access Token. Hozirgi kod Instagram Login oqimiga o'tgani sabab bu
# qiymat shart emas, faqat kelajak uchun saqlab turilyapti.
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_APP_ID=3389748577867163
INSTAGRAM_APP_SECRET=
# /api/instagram/test diagnostika endpointi uchun maxfiy kalit (o'zingiz
# uzun/tasodifiy qiymat qo'ying) — so'rov X-Admin-Secret headerida shu
# qiymatni yubormasa, endpoint 403 qaytaradi.
INSTAGRAM_DIAGNOSTIC_SECRET=
